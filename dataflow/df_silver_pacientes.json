{
	"name": "df_silver_pacientes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_pacientes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_pacientes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				},
				{
					"name": "derivedColumn7"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(full_name = initCap(lower(trim(full_name))) ) ~> derivedColumn1",
				"derivedColumn1 derive(gender = case(lower(substring(trim(gender), 1, 1)) == 'm', 'Male', lower(substring(trim(gender), 1, 1)) == 'f', 'Female', 'Other') ) ~> derivedColumn2",
				"derivedColumn2 derive(phone = regex_replace(toString(toLong(phone)), '[^0-9]', '')) ~> derivedColumn4",
				"derivedColumn4 derive(email = lower(replace(replace(trim(email), ',', '.'), ' at ', '@')) ) ~> derivedColumn5",
				"derivedColumn5 derive(insurance_provider = case(lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'cigna' || lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'cignahealth', 'Cigna', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'aetna' || lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'aetnainc' || lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'aetnaa', 'Aetna', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'bluecross', 'Blue Cross', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'medicare' || lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'medicare', 'Medicare', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'medicaid', 'Medicaid', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'unitedhealth' || lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'uhc', 'UnitedHealth', lower(replace(replace(trim(insurance_provider), '-', ''), ' ', '')) == 'selfpay', 'Self-Pay', iifNull(insurance_provider, 'Unknown')) ) ~> derivedColumn6",
				"derivedColumn6 derive(date_of_birth = toDate(date_of_birth, 'yyyy-MM-dd')) ~> derivedColumn7",
				"derivedColumn7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}